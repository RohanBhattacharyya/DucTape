# Maintainer: DucTape contributors
pkgname=ductape-git
_pkgname=ductape
pkgver=0.2.0
pkgrel=1
pkgdesc="Driver station for FRC robots, with MCP support for AI agents"
arch=('x86_64' 'aarch64')
url="https://github.com/RohanBhattacharyya/DucTape"
license=('MPL-2.0')
depends=('webkit2gtk-4.1' 'gtk3' 'systemd-libs' 'libx11' 'gcc-libs' 'glibc')
makedepends=('git' 'cargo' 'nodejs' 'npm')
provides=("$_pkgname")
conflicts=("$_pkgname")
# makepkg's LTO flags turn bundled C code into GCC bytecode that the Rust linker can't read
options=('!lto')
source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  printf "%s.r%s.g%s" \
    "$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -n1)" \
    "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
  npm --prefix ui ci --no-audit --no-fund
}

build() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  npm --prefix ui run build
  DUCTAPE_SKIP_UI_BUILD=1 cargo build --frozen --release
}

check() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  DUCTAPE_SKIP_UI_BUILD=1 cargo test --frozen --workspace
}

package() {
  cd "$_pkgname"
  make install DESTDIR="$pkgdir" PREFIX=/usr
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
